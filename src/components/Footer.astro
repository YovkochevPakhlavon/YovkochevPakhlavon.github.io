---
/** Footer for inner pages: ← Home · © year + name · Next: <page> →, plus the licence line. */
import { profile } from '../lib/profile';
import { localizePath, nextPage, useTranslations, type Lang, type PageKey } from '../i18n';

interface Props {
  lang: Lang;
  current: PageKey;
}
const { lang, current } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const next = current === 'home' ? null : nextPage(current);
---

<footer class="site-footer">
  <div class="container row">
    <a class="home" href={localizePath(lang)}>
      ← {t('footer.home')}
    </a>
    <span class="mono">
      © {year} {profile.name[lang]}
    </span>
    {next && (
      <a class="next" href={localizePath(lang, next.route)}>
        {t('footer.next')}: {t(`nav.${next.key}`)} →
      </a>
    )}
  </div>
  <div class="container license mono">
    {t('footer.license')}
    {profile.name[lang]}
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--line);
    padding-block: 20px 28px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 16px;
    font-size: var(--fs-small);
  }
  .row a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    text-decoration: none;
  }
  .home {
    color: var(--text-2);
  }
  .home:hover {
    color: var(--heading);
  }
  .next {
    font-weight: 500;
  }
  .license {
    margin-top: 4px;
    font-size: 0.75rem;
  }
</style>
