---
/**
 * Lightweight YouTube player: shows the thumbnail and a play button; the real player
 * (youtube-nocookie.com) loads only after a click. Without JavaScript the thumbnail is
 * a normal link to the video on YouTube.
 */
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  id: string;
  title: string;
}
const { lang, id, title } = Astro.props;
const t = useTranslations(lang);
---

<div class="yt" data-yt={id} data-title={title}>
  <a class="yt-link" href={`https://www.youtube.com/watch?v=${id}`} data-yt-play>
    <img
      src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
      alt=""
      width="480"
      height="360"
      loading="lazy"
      decoding="async"
    />
    <span class="play" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5.5v13l11-6.5z"></path>
      </svg>
    </span>
    <span class="visually-hidden">
      {t('video.play')}: {title}
    </span>
  </a>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((box) => {
    box.querySelector('[data-yt-play]')?.addEventListener('click', (e) => {
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = box.dataset.title ?? 'YouTube';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      box.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 12px;
    background: var(--code-bg);
  }
  .yt-link,
  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .yt-link {
    display: block;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 0.2s var(--ease);
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg);
    transform: translate(-50%, -50%);
    box-shadow: 0 0 28px rgba(242, 165, 65, 0.45);
    transition: transform 0.2s var(--ease);
  }
  .play svg {
    margin-left: 3px;
  }
  .yt-link:hover img,
  .yt-link:focus-visible img {
    opacity: 1;
  }
  .yt-link:hover .play,
  .yt-link:focus-visible .play {
    transform: translate(-50%, -50%) scale(1.08);
  }
  .yt-link:focus-visible {
    outline-offset: -4px;
  }
</style>
