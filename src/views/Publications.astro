---
/**
 * Publications. Phase 2: page header and profile links.
 * Phase 3 generates the list, filters and BibTeX export from src/data/publications.bib.
 */
import { render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import FallbackNote from '../components/FallbackNote.astro';
import { eyebrow, useTranslations, type Lang } from '../i18n';
import { getPageText } from '../lib/content';
import { profile } from '../lib/profile';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const { entry: page, fallback } = await getPageText('publications', lang);
const { Content: Intro } = await render(page);
const links = (
  [
    ['Google Scholar', profile.links.scholar],
    ['ORCID', profile.links.orcid],
  ] as const
).filter(([, url]) => url);
---

<PageLayout
  lang={lang}
  current="publications"
  title={page.data.title}
  description={page.data.description}
>
  <p class="eyebrow">{eyebrow(lang, 'publications')}</p>
  <div class="head">
    <div>
      <h1>{page.data.title}</h1>
      <div class="lead" lang={fallback ? 'en' : lang}>
        <Intro />
        <FallbackNote lang={lang} show={fallback} />
      </div>
    </div>
    {links.length > 0 && (
      <div class="links">
        {links.map(([label, url]) => (
          <a href={url} rel="me">
            {label} ↗
          </a>
        ))}
      </div>
    )}
  </div>

  <p class="next-phase card">{t('pubs.nextPhase')}</p>
</PageLayout>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 40px;
  }
  h1 {
    margin-bottom: 12px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: var(--fs-small);
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
  .next-phase {
    border-style: dashed;
    border-color: var(--line-3);
    background: transparent;
    color: var(--muted);
  }
</style>
