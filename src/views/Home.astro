---
/**
 * Home — the hero only: who I am on the left, orbital navigation on the right.
 * The six section links sit on a dashed orbit around a CSS black hole.
 * On phones (< 768px) the orbit becomes a numbered list under a small black hole.
 * Phase 6 adds the live WebGL black hole behind the links (this CSS one stays as fallback).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import LangSwitch from '../components/LangSwitch.astro';
import Portrait from '../components/Portrait.astro';
import BlackHole from '../components/BlackHole.astro';
import CvButton from '../components/CvButton.astro';
import { PAGES, localizePath, useTranslations, type Lang } from '../i18n';
import { profile } from '../lib/profile';
import { getPageText } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const { entry: home } = await getPageText('home', lang);
const [first, ...rest] = profile.name[lang].split(' ');

/** Orbit: radius 43% of the box, angles clockwise from the right (−90° = top). */
const ANGLES = [-90, -30, 30, 90, 150, 210];
const RADIUS = 43;
const sections = PAGES.filter((p) => p.key !== 'home').map((p, i) => {
  const a = (ANGLES[i]! * Math.PI) / 180;
  return {
    ...p,
    x: +(50 + RADIUS * Math.cos(a)).toFixed(2),
    y: +(50 + RADIUS * Math.sin(a)).toFixed(2),
  };
});

const profileLinks = (
  [
    ['ORCID', profile.links.orcid],
    ['Scholar', profile.links.scholar],
    ['arXiv', profile.links.arxiv],
    ['GitHub', profile.links.github],
  ] as const
).filter(([, url]) => url);
---

<BaseLayout lang={lang} route="" description={home.data.description}>
  <header class="container container--home top">
    <Logo lang={lang} />
    <LangSwitch lang={lang} route="" />
  </header>

  <main id="main" tabindex="-1" class="container container--home hero">
    <div class="intro">
      <div class="who">
        <Portrait lang={lang} variant="round" />
        <p class="meta">
          {t('home.field')}
          <br />
          <span>{profile.location[lang]}</span>
        </p>
      </div>
      <h1>
        {first}
        <br />
        {rest.join(' ')}
      </h1>
      <p class="position">{profile.position[lang]}</p>
      <p class="institution">{profile.institution[lang]}</p>
      {home.data.statement && <p class="statement">{home.data.statement}</p>}
      {home.data.chips && (
        <ul class="chips" role="list">
          {home.data.chips.map((c) => (
            <li class="chip">{c}</li>
          ))}
        </ul>
      )}
      <div class="actions">
        <CvButton lang={lang} />
        <a class="btn btn--secondary" href={localizePath(lang, 'publications')}>
          {t('cta.publications')}
        </a>
      </div>
    </div>

    <nav class="orbit-wrap" aria-label={t('nav.sections')}>
      <div class="orbit">
        <span class="ring ring--orbit" aria-hidden="true"></span>
        <span class="ring ring--inner" aria-hidden="true"></span>
        <BlackHole class="orbit-bh" />
        <canvas class="orbit-gl" aria-hidden="true" data-bh-canvas></canvas>
        <ol>
          {sections.map((s) => (
            <li style={`--x:${s.x}%;--y:${s.y}%`}>
              <a class="pill" href={localizePath(lang, s.route)}>
                <span class="num">{s.num}</span>
                {t(`nav.${s.key}`)}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>
  </main>

  <footer class="container container--home strip mono">
    <span>
      © {new Date().getFullYear()} {profile.name[lang]}
    </span>
    {profileLinks.length > 0 && (
      <span class="links">
        {profileLinks.map(([label, url]) => (
          <a href={url} rel="me">
            {label}
          </a>
        ))}
      </span>
    )}
  </footer>
</BaseLayout>

<script>
  // Live WebGL black hole: loaded only on wide screens, after the page has loaded and
  // the browser is idle. Until its first frame (or if WebGL fails) the CSS one is shown.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-bh-canvas]');
  const orbit = canvas?.closest<HTMLElement>('.orbit');
  const wide = matchMedia('(min-width: 768px)');
  let started = false;

  const start = () => {
    if (started || !canvas || !orbit || !wide.matches) return;
    started = true;
    import('../scripts/blackhole/index')
      .then(({ mountBlackHole }) =>
        mountBlackHole(canvas, {
          onReady: () => orbit.classList.add('is-webgl'),
          onFail: () => orbit.classList.remove('is-webgl'),
        }),
      )
      .catch(() => orbit.classList.remove('is-webgl'));
  };
  const whenIdle = () =>
    'requestIdleCallback' in window
      ? requestIdleCallback(start, { timeout: 2500 })
      : setTimeout(start, 400);

  if (document.readyState === 'complete') whenIdle();
  else addEventListener('load', whenIdle, { once: true });
  wide.addEventListener('change', whenIdle);
</script>

<style>
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 24px;
  }
  .hero {
    flex: 1 1 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: center;
    gap: 56px;
    padding-block: 24px 48px;
  }
  .hero:focus {
    outline: none;
  }

  /* ----- Left column ----- */
  .intro {
    flex: 1 1 480px;
    min-width: 0;
  }
  .who {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-bottom: 28px;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.8;
    color: var(--accent);
  }
  .meta span {
    color: var(--muted);
  }
  h1 {
    margin-bottom: 16px;
    font-size: var(--fs-h1-home);
    line-height: 1.02;
  }
  .position {
    margin-bottom: 8px;
    font-size: 1.125rem;
  }
  .institution {
    margin-bottom: 24px;
    color: var(--muted);
  }
  .statement {
    max-width: 540px;
    margin-bottom: 24px;
    font-size: 1.125rem;
    color: var(--text-2);
  }
  .chips {
    margin-bottom: 32px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ----- Orbit ----- */
  .orbit-wrap {
    flex: 1 1 460px;
    min-width: 0;
    display: flex;
    justify-content: center;
  }
  .orbit {
    position: relative;
    width: 100%;
    max-width: 600px;
    aspect-ratio: 1 / 1;
  }
  .ring {
    position: absolute;
    border-radius: 50%;
  }
  .ring--orbit {
    inset: 7%;
    border: 1px dashed var(--line-3);
  }
  .ring--inner {
    inset: 21%;
    border: 1px solid var(--line);
  }
  .orbit :global(.orbit-bh) {
    position: absolute;
    inset: 0;
    transition: opacity 0.8s var(--ease);
  }
  .orbit-gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.8s var(--ease);
  }
  .orbit.is-webgl .orbit-gl {
    opacity: 1;
  }
  .orbit.is-webgl :global(.orbit-bh) {
    opacity: 0;
  }
  .orbit ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .orbit li {
    position: absolute;
    z-index: 1;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    padding: 0 16px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--text);
    font-size: var(--fs-small);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 0.15s var(--ease),
      box-shadow 0.15s var(--ease),
      color 0.15s var(--ease);
  }
  .pill:hover,
  .pill:focus-visible {
    border-color: var(--accent);
    box-shadow: 0 0 18px var(--accent-glow);
    color: var(--heading);
  }
  .num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
  }

  /* ----- Footer strip ----- */
  .strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    padding-block: 20px 28px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  .links a {
    color: var(--muted);
  }
  .links a:hover {
    color: var(--accent-hi);
  }

  /* ----- Phones: list instead of orbit ----- */
  @media (max-width: 767px) {
    .hero {
      gap: 40px;
      padding-top: 8px;
    }
    .orbit-wrap {
      flex-basis: 100%;
      justify-content: flex-start;
    }
    .orbit {
      aspect-ratio: auto;
      max-width: none;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .ring,
    .orbit-gl {
      display: none;
    }
    .orbit.is-webgl :global(.orbit-bh) {
      opacity: 1;
    }
    .orbit :global(.orbit-bh) {
      position: relative;
      inset: auto;
      width: 160px;
      margin-inline: 8px;
    }
    .orbit ol {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .orbit li {
      position: static;
      transform: none;
    }
    .pill {
      width: 100%;
      min-height: 52px;
      font-size: 1rem;
    }
  }
</style>
