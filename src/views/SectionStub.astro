---
/**
 * Placeholder body for sections that arrive in a later phase
 * (interactive tools, talks, notes). Keeps every link on the site working.
 */
import PageLayout from '../layouts/PageLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { useTranslations, type Lang, type PageKey } from '../i18n';
import type { UiKey } from '../i18n/en';

interface Props {
  lang: Lang;
  /** Nav section this page belongs to (for the eyebrow and active nav item). */
  section: Exclude<PageKey, 'home'>;
  /** Language-neutral route, e.g. 'research/tools'. */
  route: string;
  titleKey: UiKey;
}
const { lang, section, route, titleKey } = Astro.props;
const t = useTranslations(lang);
---

<PageLayout lang={lang} current={section} route={route} title={t(titleKey)}>
  <PageIntro lang={lang} page={section} title={t(titleKey)}>
    <p class="placeholder">{t('page.later')}</p>
  </PageIntro>
</PageLayout>
