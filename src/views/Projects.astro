---
/**
 * Projects: featured project card(s) with roadmap and terminal block, then a grid of
 * other projects and a link to all GitHub repositories. Data: src/content/projects/*.yaml.
 */
import { render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import FallbackNote from '../components/FallbackNote.astro';
import { useTranslations, type Lang } from '../i18n';
import { getPageText, getProjects, isPlaceholder } from '../lib/content';
import { profile } from '../lib/profile';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const { entry: page, fallback } = await getPageText('projects', lang);
const { Content: Intro } = await render(page);
const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
const github = profile.links.github;
const githubLabel = github.replace(/^https?:\/\//, '').replace(/\/$/, '');

/** Splits a terminal line into styled parts. */
function terminalLine(line: string) {
  if (line.trim() === '#') return [{ text: '#', cls: 'muted' }];
  if (line.startsWith('$ '))
    return [
      { text: '$', cls: 'muted' },
      { text: ` ${line.slice(2)}`, cls: '' },
    ];
  const kv = line.match(/^([\w-]+:)(\s.*)$/);
  if (kv)
    return [
      { text: kv[1]!, cls: 'muted' },
      { text: kv[2]!, cls: '' },
    ];
  return line.split(/(→)/).map((part, i, arr) => ({
    text: part,
    cls: part === '→' ? 'muted' : i === 0 || i === arr.length - 1 ? 'accent' : '',
  }));
}
---

<PageLayout
  lang={lang}
  current="projects"
  title={page.data.title}
  description={page.data.description}
>
  <PageIntro lang={lang} page="projects" title={page.data.title}>
    <div lang={fallback ? 'en' : lang}>
      <Intro />
      <FallbackNote lang={lang} show={fallback} />
    </div>
  </PageIntro>

  {featured.map(({ data: p }) => (
    <section class="featured" aria-labelledby={`p-${p.name}`}>
      <div class="info">
        <div class="meta">
          <span class="badge">{t('projects.featured')}</span>
          <span class="mono">{[p.language, p.license].filter(Boolean).join(' · ')}</span>
        </div>
        <h2 id={`p-${p.name}`}>{p.name}</h2>
        <p class="desc">{p.description[lang]}</p>
        {p.roadmap.length > 0 && (
          <>
            <h3>{t('projects.roadmap')}</h3>
            <ol class="roadmap">
              {p.roadmap.map((r) => (
                <li class={r.state}>
                  <span class="ver">
                    {r.state === 'done' ? '✓' : r.state === 'in-progress' ? '…' : '○'} {r.version}
                  </span>
                  <span>{r.text[lang]}</span>
                </li>
              ))}
            </ol>
          </>
        )}
        {p.tags.length > 0 && (
          <ul class="chips tags" role="list">
            {p.tags.map((tag) => (
              <li class="chip">{tag}</li>
            ))}
          </ul>
        )}
        <div class="actions">
          {p.repo ? (
            <a class="btn btn--primary" href={p.repo}>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m8 6-6 6 6 6" />
                <path d="m16 6 6 6-6 6" />
              </svg>
              GitHub
            </a>
          ) : (
            <span class="btn missing">GitHub {t('projects.repoMissing')}</span>
          )}
          {p.docs ? (
            <a class="btn btn--secondary" href={p.docs}>
              {t('projects.docs')}
            </a>
          ) : (
            <span class="btn missing">
              {t('projects.docs')} {t('projects.docsMissing')}
            </span>
          )}
        </div>
      </div>
      {p.terminal.length > 0 && (
        <div class="terminal" aria-hidden="true">
          <div class="dots">
            <span />
            <span />
            <span />
          </div>
          <div class="code">
            {p.terminal.map((line) => (
              <div>
                {terminalLine(line).map((part) => (
                  <span class={part.cls}>{part.text}</span>
                ))}
              </div>
            ))}
          </div>
        </div>
      )}
    </section>
  ))}

  <h2 class="more">{t('projects.more')}</h2>
  <div class="grid">
    {others.map(({ data: p }) => (
      <div class:list={['project', { todo: isPlaceholder(p.name) }]}>
        <p class="mono">{[p.language, p.license].filter(Boolean).join(' · ')}</p>
        <h3>{p.name}</h3>
        <p class="text">{p.description[lang]}</p>
        {p.repo && (
          <a href={p.repo} class="repo">
            {t('projects.repo')} →
          </a>
        )}
      </div>
    ))}
    {others.length === 0 && (
      <div class="project todo">
        <h3>{t('projects.placeholderName')}</h3>
        <p class="text">{t('projects.placeholderText')}</p>
      </div>
    )}
    {github && (
      <a class="project all" href={github} rel="me">
        <svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 17 17 7" />
          <path d="M8 7h9v9" />
        </svg>
        <span class="all-title">{t('projects.allRepos')}</span>
        <span class="text">{githubLabel}</span>
      </a>
    )}
  </div>
</PageLayout>

<style>
  .featured {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    margin: 8px 0 64px;
    padding: clamp(24px, 4vw, 48px);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-card-lg);
    background: var(--surface);
  }
  .info {
    flex: 1 1 440px;
    min-width: 0;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .badge {
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--bg);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .featured h2 {
    margin-bottom: 16px;
    font-size: clamp(2.25rem, 1.8rem + 2vw, 2.75rem);
  }
  .desc {
    margin-bottom: 24px;
    font-size: 1.125rem;
    color: var(--text-2);
  }
  .info h3 {
    margin-bottom: 12px;
    font-size: var(--fs-small);
  }
  .roadmap {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
    font-size: var(--fs-small);
    color: var(--text-2);
  }
  .roadmap li {
    display: flex;
    gap: 12px;
    align-items: baseline;
  }
  .ver {
    flex: none;
    min-width: 7ch;
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .roadmap .in-progress,
  .roadmap .planned,
  .roadmap .in-progress .ver,
  .roadmap .planned .ver {
    color: var(--muted);
  }
  .tags {
    margin-bottom: 32px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .missing {
    border: 1px dashed var(--line-3);
    color: var(--muted);
    cursor: default;
  }

  /* Terminal */
  .terminal {
    flex: 1 1 400px;
    min-width: 0;
    align-self: center;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--code-bg);
    overflow: hidden;
  }
  .dots {
    display: flex;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
  }
  .dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line-2);
  }
  .code {
    padding: 28px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 2.1;
    color: var(--text-2);
    overflow-wrap: anywhere;
  }
  .muted {
    color: var(--muted);
  }
  .accent {
    color: var(--accent);
  }

  /* More projects */
  .more {
    margin-bottom: 24px;
    font-size: 1.75rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
  }
  .project {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
  }
  .project.todo {
    border-style: dashed;
    border-color: var(--line-3);
  }
  .project h3,
  .all-title {
    font-family: var(--font-heading);
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    color: var(--heading);
  }
  .text {
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .repo {
    margin-top: 8px;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .all {
    justify-content: center;
    background: var(--surface);
    color: var(--accent);
    text-decoration: none;
    transition: border-color 0.15s var(--ease);
  }
  .all:hover {
    border-color: var(--accent);
  }
</style>
