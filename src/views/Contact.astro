---
/**
 * Contact: email (lightly obfuscated), academic profiles (hidden when empty),
 * affiliation, and a form that posts to `formEndpoint` in profile.yaml.
 * Without an endpoint the form is replaced by a "Write me an email" button.
 */
import { render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import FallbackNote from '../components/FallbackNote.astro';
import { useTranslations, type Lang } from '../i18n';
import { getPageText } from '../lib/content';
import { profile } from '../lib/profile';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const { entry: page, fallback } = await getPageText('contact', lang);
const { Content: Intro } = await render(page);

// Email is written into the page reversed and assembled by a script, so simple
// scrapers that read the HTML do not see it.
const [user = '', domain = ''] = profile.email.split('@');
const hasEmail = Boolean(profile.email);
const rev = (s: string) => [...s].reverse().join('');

function shortLabel(key: string, url: string): string {
  try {
    const u = new URL(url);
    const path = u.pathname.replace(/\/+$/, '');
    if (key === 'orcid' || key === 'github') return path.slice(1);
    if (key === 'scopus') return u.searchParams.get('authorId') ?? u.host;
    if (key === 'scholar') return u.searchParams.get('user') ?? u.host;
    return `${u.host}${path}`.replace(/^www\./, '');
  } catch {
    return url;
  }
}
const profiles = (
  [
    ['orcid', 'ORCID'],
    ['scholar', 'Google Scholar'],
    ['arxiv', 'arXiv'],
    ['researchgate', 'ResearchGate'],
    ['scopus', 'Scopus'],
    ['github', 'GitHub'],
  ] as const
)
  .map(([key, label]) => ({
    label,
    url: profile.links[key],
    short: shortLabel(key, profile.links[key]),
  }))
  .filter((p) => p.url);
---

<PageLayout
  lang={lang}
  current="contact"
  title={page.data.title}
  description={page.data.description}
>
  <div class="layout">
    <div class="info">
      <PageIntro lang={lang} page="contact" title={page.data.title}>
        <div lang={fallback ? 'en' : lang}>
          <Intro />
          <FallbackNote lang={lang} show={fallback} />
        </div>
      </PageIntro>

      {hasEmail ? (
        <a class="email" href="#" data-u={rev(user)} data-d={rev(domain)} data-email>
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
          <span>
            <span class="small mono">{t('contact.emailLabel')}</span>
            <span class="addr" data-email-text>
              {user} [at] {domain}
            </span>
          </span>
        </a>
      ) : (
        <div class="email todo">
          <span>
            <span class="small mono">{t('contact.emailLabel')}</span>
            <span class="addr placeholder">{t('contact.emailMissing')}</span>
          </span>
        </div>
      )}

      {profiles.length > 0 && (
        <>
          <h2>{t('contact.profiles')}</h2>
          <ul class="profiles" role="list">
            {profiles.map((p) => (
              <li>
                <a href={p.url} rel="me">
                  <span class="name">{p.label}</span>
                  <span class="mono">{p.short}</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )}

      <h2>{t('contact.affiliation')}</h2>
      <p class="affiliation">
        {profile.department[lang]}
        <br />
        {profile.institution[lang]}
        <br />
        {profile.location[lang]}
      </p>
    </div>

    <div class="form-card">
      <h2>{t('contact.send')}</h2>
      {profile.formEndpoint ? (
        <form action={profile.formEndpoint} method="POST" accept-charset="utf-8">
          <label>
            {t('contact.name')}
            <input name="name" type="text" autocomplete="name" required />
          </label>
          <label>
            {t('contact.email')}
            <input name="email" type="email" autocomplete="email" required />
          </label>
          <label>
            {t('contact.message')}
            <textarea name="message" rows="6" required></textarea>
          </label>
          <input
            class="hp"
            type="text"
            name="_gotcha"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />
          <button class="btn btn--primary" type="submit">
            {t('contact.submit')}
          </button>
        </form>
      ) : hasEmail ? (
        <a class="btn btn--primary" href="#" data-u={rev(user)} data-d={rev(domain)} data-email>
          {t('contact.writeEmail')}
        </a>
      ) : (
        <span class="btn missing">
          {t('contact.writeEmail')} {t('contact.emailMissing')}
        </span>
      )}
      {hasEmail && (
        <noscript>
          <p class="small">{t('contact.noscriptEmail')}</p>
        </noscript>
      )}
    </div>
  </div>
</PageLayout>

<script>
  const rev = (s: string) => [...s].reverse().join('');
  document.querySelectorAll<HTMLAnchorElement>('[data-email]').forEach((a) => {
    const address = `${rev(a.dataset.u ?? '')}@${rev(a.dataset.d ?? '')}`;
    a.href = `mailto:${address}`;
    const text = a.querySelector<HTMLElement>('[data-email-text]');
    if (text) text.textContent = address;
  });
</script>

<style>
  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
  }
  .info {
    flex: 1 1 520px;
    min-width: 0;
  }
  .info h2 {
    margin-bottom: 16px;
    font-size: 1.375rem;
  }
  .email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-bottom: 36px;
    padding: 24px 28px;
    border: 1px solid var(--accent);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--accent);
    text-decoration: none;
  }
  .email.todo {
    border-style: dashed;
    border-color: var(--line-3);
    background: transparent;
  }
  .email > span {
    min-width: 0;
  }
  .small {
    display: block;
    font-size: 0.75rem;
  }
  .addr {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--heading);
    overflow-wrap: anywhere;
  }
  .addr.placeholder {
    color: var(--muted);
    font-weight: 500;
  }
  .profiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 12px;
    margin: 0 0 36px;
    padding: 0;
    list-style: none;
  }
  .profiles a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.15s var(--ease);
  }
  .profiles a:hover {
    border-color: var(--accent);
  }
  .name {
    font-weight: 600;
    color: var(--heading);
  }
  .profiles .mono {
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }
  .affiliation {
    color: var(--text-2);
  }

  /* Form */
  .form-card {
    flex: 1 1 400px;
    min-width: 0;
    align-self: flex-start;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(24px, 3vw, 36px);
    border: 1px solid var(--line);
    border-radius: var(--radius-card-lg);
    background: var(--surface);
  }
  .form-card h2 {
    font-size: 1.5rem;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.875rem;
    color: var(--text-2);
  }
  input,
  textarea {
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid var(--line-3);
    border-radius: 10px;
    background: var(--bg);
    color: var(--text);
    font-size: 1rem;
  }
  textarea {
    padding: 12px 14px;
    resize: vertical;
  }
  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--accent);
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .missing {
    border: 1px dashed var(--line-3);
    color: var(--muted);
    cursor: default;
  }
</style>
