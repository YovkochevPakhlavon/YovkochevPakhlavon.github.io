---
/**
 * The <html> shell for every page: language, <head> metadata, canonical URL,
 * hreflang alternates, Open Graph / Twitter cards, fonts, analytics and the skip link.
 */
import '../styles/global.css';
import Fonts from '../components/Fonts.astro';
import SkipLink from '../components/SkipLink.astro';
import { HTML_LANG, LANGS, DEFAULT_LANG, localizePath, useTranslations, type Lang } from '../i18n';
import { profile } from '../lib/profile';
import { OG_HEIGHT, OG_WIDTH, ogPath } from '../lib/og';
import { ANALYTICS } from '../config/site';

interface Props {
  lang: Lang;
  /** Language-neutral route, e.g. '' for Home, 'about'. */
  route: string;
  /** Page name; the site name is added automatically. Omit on Home. */
  title?: string;
  description?: string;
  /** Set false for pages that should not be indexed (e.g. 404). */
  index?: boolean;
  /** Open Graph type. */
  ogType?: 'website' | 'article' | 'profile';
}

const { lang, route, title, description, index = true, ogType = 'website' } = Astro.props;
const t = useTranslations(lang);
const siteName = profile.name[lang];
const fullTitle = title ? `${title} — ${siteName}` : `${siteName} — ${profile.position[lang]}`;
const metaDescription = description ?? `${siteName} — ${t('site.description')}`;
const abs = (l: Lang) => new URL(localizePath(l, route), Astro.site).href;
const ogImage = new URL(ogPath(lang, index ? route : ''), Astro.site).href;
const OG_LOCALE: Record<Lang, string> = { en: 'en_US', uz: 'uz_UZ' };
---

<!doctype html>
<html lang={HTML_LANG[lang]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={profile.name.en} />
    <meta name="theme-color" content="#0B0D12" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    {!index && <meta name="robots" content="noindex" />}
    {index && (
      <>
        <link rel="canonical" href={abs(lang)} />
        {LANGS.map((l) => (
          <link rel="alternate" hreflang={HTML_LANG[l]} href={abs(l)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={abs(DEFAULT_LANG)} />
      </>
    )}
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />

    <meta property="og:site_name" content={profile.name[lang]} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={abs(lang)} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <Fonts />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
    {ANALYTICS.enabled && ANALYTICS.goatcounter && (
      <script
        is:inline
        async
        data-goatcounter={`https://${ANALYTICS.goatcounter}.goatcounter.com/count`}
        src="https://gc.zgo.at/count.js"
      />
    )}
  </head>
  <body>
    <SkipLink lang={lang} />
    <slot />
  </body>
</html>
